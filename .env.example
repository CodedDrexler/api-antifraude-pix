API_PORT=8000
# After reviewing and applying database/migrations/003_runtime_role.sql, point
# DATABASE_URL at the restricted pix_api login. Supply its password securely;
# URL-encode special characters when constructing DATABASE_URL.
# Experimental synthetic GNN: off, shadow (records only), contribute (adds up to 20 points).
GNN_MODE=shadow
# Directed/temporal v2 observes every new Pix. Supported modes: off, shadow.
GNN_V2_MODE=shadow
# GNN_V2_MODEL_PATH=/app/models/gnn-directed-temporal-v2-seed-42.json
# Independent CPF/CNPJ history and verified corporate links: off, shadow, contribute.
ENTITY_RISK_MODE=shadow
# Trusted operator registry, outside the Pix request. No external data is queried.
# ENTITY_REGISTRY_PATH=/app/config/entity-registry.json
# Outside Docker: JSON policy file, read when the application starts.
# RISK_POLICY_PATH=config/risk-policy.json
# Required only when running uvicorn outside Docker, against your own PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://pix:pix@localhost:5432/pix
